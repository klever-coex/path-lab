<?xml version="1.0" ?>
<!-- Racing quadrotor, adapted from gym-pybullet-drones (MIT) assets/racer.urdf.

     Physics parameters are parsed by clover2gym.model.DroneModel from the
     <properties> tag. Prop links are zero-mass; their inertial origins hold
     the propeller positions, so external forces applied to a prop link act
     at the propeller position (same trick as the reference framework).
     prop_dirs: sign of the z-component of each propeller's reaction torque.
-->
<robot name="racer">

  <properties arm="0.109" kf="8.47e-9" km="2.13e-11" thrust2weight="4.17"
              max_speed_kmh="200" motor_tau="0.025" collision_radius="0.06"
              prop_dirs="-1 1 -1 1"/>

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.830"/>
      <inertia ixx=".003113" ixy="0." ixz="0." iyy=".003113" iyz="0." izz=".003113"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".14 .10 .04"/>
      </geometry>
      <material name="body">
        <color rgba=".15 .15 .15 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius=".06" length=".025"/>
      </geometry>
    </collision>
  </link>

  <link name="prop0_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0850 0.0675 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0850 0.0675 0"/>
      <geometry>
        <cylinder radius=".06" length=".006"/>
      </geometry>
      <material name="prop0"><color rgba=".9 .2 .2 1"/></material>
    </visual>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0850 0.0675 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.0850 0.0675 0"/>
      <geometry>
        <cylinder radius=".06" length=".006"/>
      </geometry>
      <material name="prop1"><color rgba=".2 .2 .9 1"/></material>
    </visual>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.085 -0.0675 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.085 -0.0675 0"/>
      <geometry>
        <cylinder radius=".06" length=".006"/>
      </geometry>
      <material name="prop2"><color rgba=".9 .2 .2 1"/></material>
    </visual>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.085 -0.0675 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.085 -0.0675 0"/>
      <geometry>
        <cylinder radius=".06" length=".006"/>
      </geometry>
      <material name="prop3"><color rgba=".2 .2 .9 1"/></material>
    </visual>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>

</robot>
